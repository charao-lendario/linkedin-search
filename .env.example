# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
APIFY_API_KEY=your_apify_api_key_here
INFOSIMPLES_API_TOKEN=your_infosimples_token_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=sqlite:./data/searches.db

# Export Paths
EXCEL_EXPORT_PATH=./exports/

# Cache Configuration (in hours)
CACHE_DURATION=6

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/
